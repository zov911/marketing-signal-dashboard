# One Google service account covers GA4 + Search Console.
# 1) Google Cloud → create service account → JSON key
# 2) Enable "Google Analytics Data API" and "Google Search Console API"
# 3) GA4: Admin → Property access management → add the service account email as Viewer
# 4) Search Console: Settings → Users and permissions → add the email (Restricted is enough)
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
# sc-domain:example.com  or  https://www.example.com/
GSC_SITE_URL=

# Bing Webmaster Tools → Settings → API access → API key
BING_SITE_URL=
BING_API_KEY=

# Your server-side GTM tagging server (custom domain)
SGTM_URL=

# Comma-separated brand terms for branded / non-branded query split
BRAND_TERMS=

PORT=8790
ALLOWED_ORIGINS=http://localhost:8790,https://zov911.github.io
# Accept credentials typed into the dashboard's "Connect data" form (local use only)
ALLOW_CLIENT_CREDENTIALS=false
